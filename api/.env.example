# ACE-Step Suno-compatible API — environment variables
# Copy to .env and fill in the values you want to override.

# ── Auth ────────────────────────────────────────────────────────────────────
# Set to require an API key on every request (Bearer token).
# Leave empty to disable authentication entirely.
API_KEY=

# ── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080

# ── ACE-Step DiT model ──────────────────────────────────────────────────────
# HuggingFace model ID or local path.
# Use "acestep-v15-turbo" for the fast 4B turbo checkpoint.
CONFIG_PATH=acestep-v15-turbo

# ── ACE-Step LLM model ──────────────────────────────────────────────────────
# Path (local) or HuggingFace ID of the 5Hz LM checkpoint.
LM_MODEL_PATH=

# ── Device ──────────────────────────────────────────────────────────────────
# auto | cuda | mps | cpu
DEVICE=auto

# ── LLM back-end ────────────────────────────────────────────────────────────
# transformers | nano-vllm | mlx-lm
LM_BACKEND=transformers

# ── Performance ─────────────────────────────────────────────────────────────
INIT_LLM=true
USE_FLASH_ATTENTION=false
COMPILE_MODEL=false
OFFLOAD_TO_CPU=false
OFFLOAD_DIT_TO_CPU=false

# ── Generation defaults ─────────────────────────────────────────────────────
BATCH_SIZE=2
# Output audio format: flac | mp3 | wav
AUDIO_FORMAT=flac

# ── Task management ─────────────────────────────────────────────────────────
# How long (seconds) to keep completed/failed tasks before purging.
# Default: 15 days (1_296_000 s).
TASK_TTL_SECONDS=1296000

# ── Credits simulation ──────────────────────────────────────────────────────
# Returned by GET /api/v1/generate/credit
SIMULATED_CREDITS=9999
