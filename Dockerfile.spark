# =============================================================================
# ACE-Step 1.5 — NVIDIA DGX Spark (GB10) Dockerfile
# =============================================================================
#
# Builds ACE-Step 1.5 with GPU acceleration for NVIDIA DGX Spark.
#
# Supported hardware:
#   - NVIDIA DGX Spark (GB10 Grace Blackwell Superchip, 128 GB unified memory)
#   - Architecture: ARM64 (aarch64)
#   - CUDA Compute Capability: sm_121
#
# Requirements:
#   - DGX OS (Ubuntu 24.04 based)
#   - NVIDIA Container Toolkit and Docker
#
# Build:
#   docker build -f Dockerfile.spark -t acestep-spark .
#
# Run (Gradio UI — default, models pre-loaded at startup):
# IMPORTANT FOR DGX SPARK: Use --ipc=host and ulimits to properly allocate 
# the Grace Blackwell unified memory.
#   docker run -it --rm \
#     --gpus all \
#     --ipc=host \
#     --ulimit memlock=-1 \
#     --ulimit stack=67108864 \
#     -p 7860:7860 \
#     -v $(pwd)/checkpoints:/app/checkpoints \
#     -v $(pwd)/gradio_outputs:/app/gradio_outputs \
#     acestep-spark
#
# Run (REST API server):
#   docker run -it --rm \
#     --gpus all \
#     --ipc=host \
#     --ulimit memlock=-1 \
#     --ulimit stack=67108864 \
#     -p 8001:8001 \
#     -v $(pwd)/checkpoints:/app/checkpoints \
#     -e ACESTEP_MODE=api \
#     acestep-spark
#
# =============================================================================

# ==================== Base image ====================
# Utilizziamo il container ufficiale PyTorch di NVIDIA per ARM64. 
# Questo include PyTorch 2.x, Triton, torchaudio, e torchvision 
# pre-ottimizzati specificatamente per l'architettura Blackwell (sm_121) e CUDA 13.
FROM nvcr.io/nvidia/pytorch:26.01-py3

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# ==================== System packages ====================
RUN apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common \
        build-essential \
        cmake \
        git \
        curl \
        wget \
        pkg-config \
        libsndfile1 \
        libsndfile1-dev \
        nasm \
        yasm \
        libx264-dev \
        libx265-dev \
        libmp3lame-dev \
        libopus-dev \
        libvorbis-dev \
        libopenblas-dev \
        liblapack-dev \
        gfortran \
    && rm -rf /var/lib/apt/lists/*

# ==================== FFmpeg 7 (from source) ====================
# torchcodec 0.10.0 richiede le librerie condivise di FFmpeg 7.
ARG FFMPEG_VERSION=7.1
RUN cd /tmp \
    && curl -fSL "https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.xz" -o ffmpeg.tar.xz \
    && tar xf ffmpeg.tar.xz \
    && cd ffmpeg-${FFMPEG_VERSION} \
    && ./configure \
        --prefix=/usr/local \
        --enable-shared \
        --disable-static \
        --enable-gpl \
        --enable-libx264 \
        --enable-libx265 \
        --enable-libmp3lame \
        --enable-libopus \
        --enable-libvorbis \
        --disable-doc \
        --disable-programs \
    && make -j$(nproc) \
    && make install \
    && ldconfig \
    && cd /tmp && rm -rf ffmpeg* \
    && echo "FFmpeg $(ffmpeg -version 2>&1 | head -1 || echo 'libs installed')"

# Assicurati che pip sia aggiornato
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# ==================== torchcodec ====================
# Il DGX Spark ha GPU ad alte prestazioni. A differenza del Jetson,
# abilitiamo ENABLE_CUDA=1 per sfruttare a pieno l'accelerazione hardware.
ARG TORCHCODEC_VERSION=v0.10.0
RUN pip install --no-cache-dir pybind11 \
    && cd /tmp \
    && git clone --depth 1 --branch ${TORCHCODEC_VERSION} \
        https://github.com/pytorch/torchcodec.git \
    && cd torchcodec \
    && CMAKE_PREFIX_PATH="$(python -c 'import pybind11; print(pybind11.get_cmake_dir())'):${CMAKE_PREFIX_PATH}" \
       PKG_CONFIG_PATH="/usr/local/lib/pkgconfig:${PKG_CONFIG_PATH}" \
       ENABLE_CUDA=1 \
       I_CONFIRM_THIS_IS_NOT_A_LICENSE_VIOLATION=1 \
       pip install --no-cache-dir --no-build-isolation . \
    && cd /tmp && rm -rf torchcodec

# ==================== Project source ====================
WORKDIR /app
COPY . /app/

# ==================== Python dependencies ====================
# PyTorch, Triton e librerie core CUDA sono già gestite ottimamente 
# dall'immagine base NVIDIA. Installiamo solo i restanti layer applicativi.
RUN pip install --no-cache-dir \
        "transformers>=4.51.0,<4.58.0" \
        "diffusers" \
        "gradio==6.2.0" \
        "matplotlib>=3.7.5" \
        "scipy>=1.10.1" \
        "soundfile>=0.13.1" \
        "loguru>=0.7.3" \
        "einops>=0.8.1" \
        "accelerate>=1.12.0" \
        "fastapi>=0.110.0" \
        "diskcache" \
        "uvicorn[standard]>=0.27.0" \
        "numba>=0.63.1" \
        "vector-quantize-pytorch>=1.27.15" \
        "toml" \
        "safetensors" \
        "modelscope" \
        "peft>=0.18.0" \
        "lycoris-lora" \
        "lightning>=2.0.0" \
        "tensorboard>=2.20.0" \
        "typer-slim>=0.21.1" \
        "xxhash" \
        "pyyaml" \
        "bitsandbytes>=0.49.0"

RUN TORCH_VERSION=$(python -c "import re, torch; print(re.sub(r'(a|b|rc)\\d+$', '', torch.__version__.split('+')[0]))") \
    && pip install --no-cache-dir --no-deps "torchaudio==${TORCH_VERSION}" \
    && python -c "import torchaudio; print(f'torchaudio {torchaudio.__version__} OK')"

# Install nano-vllm
RUN pip install --no-cache-dir --no-deps /app/acestep/third_parts/nano-vllm \
    && python -c "import nanovllm; print('nano-vllm OK')"

# ==================== Runtime directories ====================
RUN mkdir -p /app/checkpoints /app/gradio_outputs

# ==================== DGX Spark defaults ====================
ENV ACESTEP_LLM_BACKEND=vllm
ENV ACESTEP_API_HOST=0.0.0.0
ENV GRADIO_SERVER_NAME=0.0.0.0
ENV ACESTEP_MODE=gradio
ENV ACESTEP_INIT_SERVICE=true
ENV ACESTEP_CONFIG_PATH=acestep-v15-turbo
ENV ACESTEP_LM_MODEL_PATH=acestep-5Hz-lm-4B
ENV TOKENIZERS_PARALLELISM=false

EXPOSE 7860 8001

HEALTHCHECK --interval=60s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -sf http://localhost:${GRADIO_PORT:-7860}/ > /dev/null 2>&1 \
     || curl -sf http://localhost:${ACESTEP_API_PORT:-8001}/health > /dev/null 2>&1 \
     || exit 1

COPY <<'EOF' /app/docker-entrypoint.sh
#!/usr/bin/env bash
set -e

echo "======================================================"
echo "  ACE-Step 1.5 — NVIDIA DGX Spark (GB10) Container"
echo "======================================================"
echo "Mode      : ${ACESTEP_MODE}"
echo "Python    : $(python --version 2>&1)"
echo "PyTorch   : $(python -c 'import torch; print(torch.__version__)' 2>/dev/null || echo 'N/A')"

if python -c 'import torch; assert torch.cuda.is_available()' 2>/dev/null; then
    echo "CUDA      : $(python -c 'import torch; print(torch.version.cuda)')"
    echo "GPU       : $(python -c 'import torch; print(torch.cuda.get_device_name(0))')"
    echo "Memory    : $(python -c 'import torch; p=torch.cuda.get_device_properties(0); print(f"{p.total_memory/1024**3:.1f} GB")')"
else
    echo "CUDA      : NOT AVAILABLE — running on CPU"
    echo "           (make sure you launched with --gpus all)"
fi
echo "======================================================"

# Build --init_service flags when ACESTEP_INIT_SERVICE=true
INIT_ARGS=""
if [ "${ACESTEP_INIT_SERVICE:-true}" = "true" ]; then
    INIT_ARGS="--init_service true"
    [ -n "${ACESTEP_CONFIG_PATH:-}" ]   && INIT_ARGS="${INIT_ARGS} --config_path ${ACESTEP_CONFIG_PATH}"
    [ -n "${ACESTEP_LM_MODEL_PATH:-}" ] && INIT_ARGS="${INIT_ARGS} --init_llm true --lm_model_path ${ACESTEP_LM_MODEL_PATH}"
    echo "Auto-init    : DiT=${ACESTEP_CONFIG_PATH:-auto}  LM=${ACESTEP_LM_MODEL_PATH:-none}"
fi

if [ "${ACESTEP_MODE}" = "api" ]; then
    echo "Starting REST API server on 0.0.0.0:${ACESTEP_API_PORT:-8001} ..."
    exec python -m acestep.api_server \
        --host "${ACESTEP_API_HOST:-0.0.0.0}" \
        --port "${ACESTEP_API_PORT:-8001}" \
        ${ACESTEP_EXTRA_ARGS:-}
else
    echo "Starting Gradio UI on 0.0.0.0:${GRADIO_PORT:-7860} ..."
    exec python -m acestep.acestep_v15_pipeline \
        --server-name "${GRADIO_SERVER_NAME:-0.0.0.0}" \
        --port "${GRADIO_PORT:-7860}" \
        --backend "${ACESTEP_LLM_BACKEND:-pt}" \
        ${INIT_ARGS} \
        ${ACESTEP_EXTRA_ARGS:-}
fi
EOF

RUN chmod +x /app/docker-entrypoint.sh

ENTRYPOINT ["/app/docker-entrypoint.sh"]